# Copy to .env (git-ignored) and set a password. compose.yaml refuses to start without it.
# It is a local development value only; do not reuse a real password.
# Avoid ';' in the password: it is placed in an Npgsql connection string.
POSTGRES_PASSWORD=

# Optional; the defaults are shown.
# POSTGRES_USER=shipping
# POSTGRES_DB=shipping
# SHIPPING_HTTP_PORT=8000
# SHIPPING_HOST=localhost
