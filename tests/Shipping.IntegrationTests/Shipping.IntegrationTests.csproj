<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Shipping.Platform.Api/Shipping.Platform.Api.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- The real host's container, as the runtime tests resolve each module's context from it. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MPCore.Persistence.EntityFrameworkCore.PostgreSql" Version="0.10.1" />
    <!-- A real PostgreSQL in a container: schemas, migration history and DDL are PostgreSQL behaviour that
         an in-memory provider does not have. Needs a Docker engine. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/ModulePersistence.cs" Link="Shared/ModulePersistence.cs" />
  </ItemGroup>

</Project>
